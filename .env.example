# Server: .env next to deploy/compose.yaml on the host. update.sh fills in the two images.
PENDENZ_API_IMAGE=
PENDENZ_MCP_IMAGE=
# The public HTTPS address of the server. The MCP endpoint is this address with /mcp.
PENDENZ_ORIGIN=https://pendenz.example.com
PENDENZ_TIMEZONE=Europe/Zurich
# The loopback ports for a reverse proxy on the host.
PENDENZ_API_PORT=8080
PENDENZ_MCP_PORT=8090
# The push relay that asks the apps to sync after a change, and its key. Empty means no push.
PENDENZ_PUSH_RELAY=
PENDENZ_PUSH_RELAY_KEY=
# Where update.sh takes the images from. A fork that publishes its own images sets both.
# PENDENZ_IMAGE_PREFIX=ghcr.io/unveroleone/pendenz
# PENDENZ_SOURCE_URL=https://github.com/unveroleone/pendenz

# A Cloudflare Tunnel in place of a reverse proxy (deploy/compose.tunnel.yaml).
# COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:...
# CLOUDFLARE_TUNNEL_TOKEN=

# CLI and stdio MCP (agent/)
PENDENZ_API_URL=https://pendenz.example.com
PENDENZ_API_TOKEN=
# Set to telegram for an agent that captures items from Telegram. Leave empty elsewhere.
PENDENZ_SOURCE=
