{
  "name": "pendenz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:api": "PENDENZ_AUTH_MODE=local cargo run --bin pendenz",
    "check": "cargo clippy -- -D warnings && prettier --check .",
    "pendenz": "node agent/cli.mjs",
    "mcp": "node agent/mcp.mjs",
    "format": "prettier --write . && cargo fmt",
    "check:swift": "swiftformat --lint .",
    "format:swift": "swiftformat ."
  },
  "devDependencies": {
    "prettier": "^3.10.0"
  }
}
